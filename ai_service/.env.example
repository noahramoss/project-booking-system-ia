# Microservicio de IA (FastAPI). En Render estas variables se definen en el dashboard.

# Clave de Groq (LLM gratis: gpt-oss-120b / qwen3-32b)
GROQ_API_KEY=tu_clave_de_groq_aqui

# URL del backend Node al que llaman las tools del agente.
# Local: http://localhost:3000/api
# Producción: https://tu-backend.onrender.com/api
NODE_API_URL=http://localhost:3000/api